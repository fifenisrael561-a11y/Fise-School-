# Flutter build-time values. Never commit a real .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NOTCHPAY_PUBLIC_KEY=your-notchpay-public-key
GEMINI_API_KEY=your-gemini-api-key

# Supabase Edge Function deployment values belong in GitHub Actions or the
# Supabase CLI environment, never in Flutter source files.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key